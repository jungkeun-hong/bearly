# Copy to .env.local and fill in. Nothing here is committed.

# Gemini: the voice agent (Gemini Live), reading product labels, and speech to text as a fallback.
GEMINI_API_KEY=

# Jev (TypeSafe System One): the boxes around what you hold, wear or look at.
JEV_API_KEY=

# Stripe: use a TEST key only (sk_test_...). The payment routes refuse anything else.
STRIPE_SECRET_KEY=

# ElevenLabs: speech to text (first choice) and a spoken-reply route.
ELEVENLABS_API_KEY=
# Optional: OpenAI as a speech to text fallback.
OPENAI_API_KEY=

# LiveKit: carries the glasses video and microphone from the phone app to this page.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: room name (default bearly).
VB_LIVEKIT_ROOM=bearly

# Deepgram: English subtitles of what the wearer says (a 60-second token is minted on the server).
DEEPGRAM_API_KEY=

# Gmail: "send to my own inbox" (quote and manager email). Path to a Google OAuth token JSON
# (client_id, client_secret, refresh_token) with the gmail.send scope. The email always goes to that account only.
GOOGLE_TOKEN_FILE=

# Optional overrides.
# VB_LIVE_MODEL=gemini-3.8-live
# VB_LIVE_FALLBACK_MODEL=gemini-3.1-flash-live-preview
# VB_LIVE_VOICE=Leda
# VB_DEPTH_URL=http://127.0.0.1:3128/depth
